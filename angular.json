{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@schematics/angular",
      "playwright-ng-schematics"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              }
            ],
            "styles": [
              "projects/demo/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "e2e": {
          "builder": "playwright-ng-schematics:playwright",
          "options": {
            "devServerTarget": "demo:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "demo:serve:production"
            }
          }
        }
      }
    },
    "ngx-tw": {
      "projectType": "library",
      "root": "projects/ngx-tw",
      "sourceRoot": "projects/ngx-tw/src",
      "prefix": "xtw",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-tw/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-tw/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-tw/tsconfig.spec.json",
            "setupFiles": [
              "projects/ngx-tw/test-setup.ts"
            ],
            "include": [
              "src/**/*.spec.ts",
              "../theme/**/*.spec.ts",
              "../badge/**/*.spec.ts",
              "../button/**/*.spec.ts",
              "../card/**/*.spec.ts",
              "../flip-card/**/*.spec.ts",
              "../core/**/*.spec.ts",
              "../alert/**/*.spec.ts",
              "../tabs/**/*.spec.ts",
              "../tab-nav/**/*.spec.ts",
              "../separator/**/*.spec.ts",
              "../tooltip/**/*.spec.ts",
              "../code-block/**/*.spec.ts",
              "../segmented-control/**/*.spec.ts",
              "../avatar/**/*.spec.ts",
              "../icon/**/*.spec.ts",
              "../menu/**/*.spec.ts",
              "../popover/**/*.spec.ts",
              "../dialog/**/*.spec.ts",
              "../command-palette/**/*.spec.ts",
              "../toast/**/*.spec.ts",
              "../collapsible/**/*.spec.ts",
              "../accordion/**/*.spec.ts",
              "../form-field/**/*.spec.ts",
              "../switch/**/*.spec.ts",
              "../checkbox/**/*.spec.ts",
              "../radio/**/*.spec.ts",
              "../select/**/*.spec.ts",
              "../input/**/*.spec.ts",
              "../spinner/**/*.spec.ts",
              "../progress-bar/**/*.spec.ts",
              "../skeleton/**/*.spec.ts",
              "../slider/**/*.spec.ts",
              "../stepper/**/*.spec.ts",
              "../paginator/**/*.spec.ts",
              "../sort/**/*.spec.ts",
              "../table/**/*.spec.ts",
              "../calendar/**/*.spec.ts",
              "../date-picker/**/*.spec.ts",
              "../date-range-picker/**/*.spec.ts",
              "../time-picker/**/*.spec.ts",
              "../item/**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}