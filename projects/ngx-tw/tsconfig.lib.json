    "collapsible/**/*.ts",
    "combobox/**/*.ts",
    "command-palette/**/*.ts",
    "core/**/*.ts",
    "date-picker/**/*.ts",
    "date-range-picker/**/*.ts",
    "dialog/**/*.ts",
